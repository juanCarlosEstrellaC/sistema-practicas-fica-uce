# ==============================================================
# Plantilla de Variables de Entorno - frontend (Next.js 16)
# Copiar este archivo a .env.local dentro de frontend/ para desarrollo local
# ==============================================================

# 1. URL publica para llamadas cliente (enrutadas a traves del proxy local de Next.js)
NEXT_PUBLIC_API_URL=/api/proxy

# 2. URL del backend Spring Boot (consumida por Server Actions y proxy)
BACKEND_URL=http://localhost:8080/api/v1
