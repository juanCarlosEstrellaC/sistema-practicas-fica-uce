# ==============================================================
# Plantilla de Variables de Entorno - ppp_uce (Next.js)
# ==============================================================

# URL publica para llamadas cliente (enrutadas a traves del proxy local de Next.js)
NEXT_PUBLIC_API_URL=/api/proxy

# URL del backend Spring Boot (consumida exclusivamente por el servidor Next.js en Server Actions y proxy)
BACKEND_URL=http://localhost:8080/api/v1
