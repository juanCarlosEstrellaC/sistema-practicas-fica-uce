# ==============================================================
# Plantilla de Variables de Entorno - api_pp_uce (Spring Boot)
# Copia este archivo a .env y define los valores segun tu entorno.
# NUNCA subas el archivo .env real con credenciales a control de versiones.
# ==============================================================

# Perfil activo de Spring (dev / prod / test)
SPRING_PROFILES_ACTIVE=dev

# Puerto y contexto del servidor
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# Base de Datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prueba_1?stringtype=unspecified&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_contrasenia_aqui

# Secreto criptografico JWT (minimo 256 bits / 32 bytes de alta entropia)
# Generar con: openssl rand -base64 48
JWT_SECRET=reemplazar_con_clave_secreta_de_alta_entropia_minimo_32_caracteres_1234567890!@#

# Expiracion del token JWT en milisegundos (ej. 8 horas = 28800000)
JWT_EXPIRATION=28800000

# Ruta base para almacenamiento de archivos (en local: archivos_subidos; en Docker: /app/archivos_subidos)
APP_ALMACENAMIENTO_RUTA_BASE=archivos_subidos

# Servidor SMTP de correo electronico (Mailpit local / Mailtrap / Produccion)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=noreply@uce.edu.ec
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
