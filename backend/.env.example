# ==============================================================
# Plantilla de Variables de Entorno - backend (Spring Boot)
# Copiar este archivo a .env dentro de backend/ para desarrollo local
# ==============================================================

# 1. Perfil y Servidor
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# 2. Base de Datos (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/prueba_1?stringtype=unspecified&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_contrasenia_aqui

# 3. Almacenamiento de Archivos
# En local: archivos_subidos; en Docker: /app/archivos_subidos
APP_ALMACENAMIENTO_RUTA_BASE=archivos_subidos

# 4. Seguridad y Autenticacion JWT
# Generar clave segura de 32 bytes en hex: openssl rand -hex 32
JWT_SECRET=reemplazar_con_clave_hexadecimal_de_64_caracteres
JWT_EXPIRATION=28800000
JWT_ISSUER=api_pp_uce
JWT_AUDIENCE=ppp_uce

# 5. Servidor SMTP de Correo (Mailpit local por defecto)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=noreply@uce.edu.ec
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false

# 6. Origenes Permitidos (CORS)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
