# ==============================================================
# Plantilla de Variables de Entorno - Docker Compose (Raiz)
# Copiar este archivo a .env en la raiz antes de ejecutar:
# docker compose up -d --build
# ==============================================================

# 1. Variables Obligatorias (Exigidas por docker-compose.yml)
DB_PASSWORD=tu_contrasenia_postgres_segura
# Generar clave en hex de 32 bytes con: openssl rand -hex 32
JWT_SECRET=reemplazar_con_clave_hexadecimal_de_64_caracteres

# 2. Perfil y URL Publica (Cloudflare Tunnel / HTTPS)
SPRING_PROFILES_ACTIVE=prod
# URL publica usada en los enlaces de activacion y recuperacion de contrasenia
APP_FRONTEND_URL=https://practicas.tudominio.com
# Origenes permitidos por CORS (separados por coma, sin barra final)
APP_CORS_ALLOWED_ORIGINS=https://practicas.tudominio.com

# 3. Base de Datos (Opcional: tienen valores por defecto en compose)
DB_NAME=db_practicas_fica_uce
DB_USER=postgres

# 4. Correo (Por defecto usa el contenedor Mailpit en 127.0.0.1:8025)
# Para usar SMTP real en lugar de Mailpit, descomentar y completar:
# SPRING_MAIL_HOST=smtp.tudominio.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=noreply@uce.edu.ec
# SPRING_MAIL_PASSWORD=tu_clave_smtp
# SPRING_MAIL_AUTH=true
# SPRING_MAIL_STARTTLS=true
